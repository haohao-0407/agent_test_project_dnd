{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/playscript.schema.json",
  "title": "Stage 0 Playscript Folder Contract",
  "type": "object",
  "description": "Reference contract for scripts/demo files. Runtime validation lives in playscript_agent.script.schema.",
  "required": ["meta", "characters", "background", "clues", "truth", "dm_manual"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["script_id", "title", "min_players", "max_players", "phases"],
      "properties": {
        "script_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "min_players": { "type": "integer", "minimum": 1 },
        "max_players": { "type": "integer", "minimum": 1 },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "synopsis": { "type": "string" }
      }
    },
    "visibility": {
      "type": "string",
      "pattern": "^(public|dm_only|character:[A-Za-z0-9_-]+)$"
    },
    "phase": { "type": "integer", "minimum": 0 }
  }
}
